{
  "name": "avilog-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter avilog build",
    "build:ui": "bun run --filter @avilog/web-inspector build",
    "test": "bun test",
    "typecheck": "bun run --filter avilog typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
